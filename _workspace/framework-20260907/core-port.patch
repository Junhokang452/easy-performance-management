diff --git a/easy-platform-core/build.gradle.kts b/easy-platform-core/build.gradle.kts
index 1a956f3..2a63d29 100644
--- a/easy-platform-core/build.gradle.kts
+++ b/easy-platform-core/build.gradle.kts
@@ -14,7 +14,7 @@ group = "com.easyware.platform"
 // publish-poc.yml dispatch 시 PACKAGE_VERSION env 로 오버라이드 (workflow input.version → publish-maven job env).
 // 로컬/composite build 는 미설정 → 0.1.0-SNAPSHOT fallback. ORG_GRADLE_PROJECT_version 은 Gradle 6+ 에서 read-only
 // project.version 에 무시되므로 명시적 env 패턴 채택 (dry-run R1 결과).
-version = System.getenv("PACKAGE_VERSION") ?: "0.1.0-SNAPSHOT"
+version = System.getenv("PACKAGE_VERSION") ?: "1.0.0-SNAPSHOT"
 
 java {
     toolchain { languageVersion.set(JavaLanguageVersion.of(21)) }
@@ -23,9 +23,9 @@ java {
 
 repositories { mavenCentral() }
 
-// 제품들과 동일한 Spring Boot 3.4.5 BOM 으로 버전 정렬(드리프트 방지).
+// Supported suite baseline; see suite-framework-security-baseline-2026-09 conformance.
 dependencyManagement {
-    imports { mavenBom("org.springframework.boot:spring-boot-dependencies:3.4.5") }
+    imports { mavenBom("org.springframework.boot:spring-boot-dependencies:4.1.1") }
 }
 
 dependencies {
@@ -35,6 +35,8 @@ dependencies {
     api("org.springframework:spring-tx")
     api("org.springframework.boot:spring-boot")
     api("org.springframework.boot:spring-boot-autoconfigure")
+    // Boot 4 moved Flyway customizers out of the general autoconfigure module.
+    api("org.springframework.boot:spring-boot-starter-flyway")
     api("com.zaxxer:HikariCP")
     api("org.flywaydb:flyway-core")
     // Flyway 10+ 는 PostgreSQL 지원이 별도 모듈. core 의 TenantSchemaMigrator/NeonProvisioningService 가 직접
@@ -46,6 +48,8 @@ dependencies {
     api("com.fasterxml.jackson.core:jackson-annotations")
     // databind = api: 시드 시스템(SeedContext/SeedTemplateSnapshot)이 JsonNode 를 공개 API 로 노출(소비자 컴파일).
     api("com.fasterxml.jackson.core:jackson-databind")
+    // Transitional public JsonNode/ObjectMapper compatibility; migrate before Boot 4.3.
+    api("org.springframework.boot:spring-boot-jackson2")
     // WH-α-10a (BE-CC-1 audit): JPA + Spring Data — @MappedSuperclass/@EntityListeners/AuditorAware 노출.
     // ware/hcm 이미 spring-boot-starter-data-jpa 보유 — api 노출이 소비자 컴파일 안전.
     api("org.springframework.boot:spring-boot-starter-data-jpa")
@@ -71,7 +75,7 @@ dependencies {
     // ware/hcm/mra/job-* 자매품이 이미 spring-boot-starter-aop 보유 — api 노출 안전.
     // @ConditionalOnProperty(name="easyplatform.b2c.enabled", havingValue="true") 게이트로
     // B2B-only 자매품(ware/hcm/time/recruit)은 기본 OFF — autoconfig 무영향.
-    api("org.springframework.boot:spring-boot-starter-aop")
+    api("org.springframework.boot:spring-boot-starter-aspectj")
 
     compileOnly("jakarta.annotation:jakarta.annotation-api")
 
@@ -89,13 +93,15 @@ dependencies {
 
     // WH-α-10a (BE-CC-1 audit): JUnit 5 + spring-test — autoconfig/superclass 단위 테스트.
     testImplementation("org.springframework.boot:spring-boot-starter-test")
+    // Align the launcher with Boot's JUnit 6 BOM rather than Gradle's bundled launcher.
+    testRuntimeOnly("org.junit.platform:junit-platform-launcher")
 
     // ADR-055 b2 후속: Testcontainers — shell-only provisioning + Option B self-migrate 상태 전이를 실 Postgres 로
     // 검증(통합 슬라이스). testImplementation = 소비자 무영향. 버전은 Spring Boot BOM(3.4.5) 관리.
     // Docker 없는 환경은 ControlPlaneSelfMigrateTest 의 @BeforeAll(수동 DockerClientFactory 확인 후 start) + Assumptions
     // 로 우아하게 skip(@Tag("testcontainers") 로 선택 필터). 기본 gradlew test 는 Docker 없어도 fail 안 함.
-    testImplementation("org.testcontainers:postgresql")
-    testImplementation("org.testcontainers:junit-jupiter")
+    testImplementation("org.testcontainers:testcontainers-postgresql")
+    testImplementation("org.testcontainers:testcontainers-junit-jupiter")
     // (flyway-database-postgresql 은 위 runtimeOnly 로 core 에 보강 — 테스트 클래스패스에도 포함됨)
 }
 
